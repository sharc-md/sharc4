	## Path of OpenQP executable 
openqpdir /global/mai/SHARC_4.0_beta_tests/OpenQP/OpenQP/openqp/
openqpexe /user/mai/.local/share/mamba/envs/sharc_with_openqp/bin/openqp

	## Scratch directory 
scratchdir /scratch/

	## Number of CPUs for OpenMP and wfoverlap arallelization 
ncpu 1 

	## Path to wfoverlap
wfoverlap /usr/software/sharc/bin/wfoverlap.x

	## Threshold for wfoverlap calculation
wfthres 0.998

	## Memory for wfoverlap calculation in MB
wfmemory 2000

